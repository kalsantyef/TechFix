    <!-- CONEXIÓN CON BACKEND DB (API REST Y JAVASCRIPT) -->
    <script>
        function formatARS(amount) {
            return '$ ' + new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 }).format(amount) + ' ARS';
        }

        let BRANDS_DATA = [];
        let PRODUCTS = [];
        let PREBUILT_PCS = [];
        let cart = [];
        let activeCategory = 'all';
        let discountPercentage = 0;
        let builderSelection = { cpu: null, motherboard: null, gpu: null, ram: null, storage: null, psu: null };

        async function loadDatabase() {
            try {
                const res = await fetch('/api/data');
                const data = await res.json();
                BRANDS_DATA = data.brands;
                PRODUCTS = data.products;
                PREBUILT_PCS = data.prebuilts;
                
                renderFeaturedProducts();
                renderCatalog();
                renderPrebuiltPCs();
                renderBuilderOptions();
                renderBrandsGrid();
            } catch (err) {
                console.error("Error conectando con la Base de Datos TechFix:", err);
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            loadDatabase();
        });

        function navigateTo(sectionId) {
            document.querySelectorAll('.page-section').forEach(sec => sec.classList.add('hidden'));
            const target = document.getElementById(`sec-${sectionId}`);
            if (target) {
                target.classList.remove('hidden');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function toggleMobileMenu() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        }

        function renderBrandsGrid() {
            const container = document.getElementById('brands-grid-container');
            if (!container) return;
            container.innerHTML = BRANDS_DATA.map(b => {
                const count = PRODUCTS.filter(p => p.brand.toLowerCase() === b.brandKey.toLowerCase()).length;
                return `
                    <div onclick="selectBrand('${b.id}')" class="bg-tech-card border border-tech-border p-6 rounded-xl flex flex-col items-center justify-center hover:border-tech-blue hover:shadow-neon-sm transition-all cursor-pointer group text-center">
                        <span class="font-orbitron font-black text-2xl text-slate-300 group-hover:text-tech-blue transition-colors">${b.name}</span>
                        <span class="text-[11px] font-mono text-slate-400 mt-2 flex items-center gap-1 group-hover:text-white transition-colors">
                            <i class="fa-solid fa-box text-tech-blue text-[10px]"></i> ${count} producto${count !== 1 ? 's' : ''}
                        </span>
                    </div>
                `;
            }).join('');
        }

        function selectBrand(brandId) {
            const brand = BRANDS_DATA.find(b => b.id === brandId);
            if (!brand) return;

            const bannerContainer = document.getElementById('brand-banner-container');
            bannerContainer.className = `relative overflow-hidden bg-gradient-to-r ${brand.bgGradient} border border-tech-border rounded-2xl p-8 sm:p-12 shadow-2xl`;
            bannerContainer.innerHTML = `
                <div class="relative z-10 max-w-3xl space-y-4">
                    <span class="px-3 py-1 bg-tech-black/65 border border-tech-blue/40 text-tech-blue font-mono text-xs font-bold uppercase rounded-full inline-block">MARCA OFICIAL PARTNER</span>
                    <h1 class="font-orbitron text-4xl sm:text-5xl font-black text-white tracking-wider">${brand.name}</h1>
                    <p class="font-rajdhani text-lg font-bold text-tech-blue uppercase tracking-widest">${brand.slogan}</p>
                    <p class="text-slate-300 text-sm sm:text-base font-light leading-relaxed">${brand.desc}</p>
                </div>
            `;

            const filtered = PRODUCTS.filter(p => p.brand.toLowerCase() === brand.brandKey.toLowerCase());
            const productsContainer = document.getElementById('brand-products-grid');
            productsContainer.innerHTML = filtered.map(p => createProductCardHTML(p)).join('');

            document.getElementById('brands-list-view').classList.add('hidden');
            document.getElementById('brand-detail-view').classList.remove('hidden');
            navigateTo('marcas');
        }

        function showBrandsOverview() {
            document.getElementById('brand-detail-view').classList.add('hidden');
            document.getElementById('brands-list-view').classList.remove('hidden');
        }

        function filterCatalog(category) {
            activeCategory = category;
            document.querySelectorAll('.cat-filter-btn').forEach(btn => {
                btn.classList.remove('bg-tech-blue', 'text-black');
                btn.classList.add('bg-tech-darker', 'text-slate-300');
            });
            const activeBtn = document.getElementById(`cat-btn-${category}`);
            if (activeBtn) {
                activeBtn.classList.remove('bg-tech-darker', 'text-slate-300');
                activeBtn.classList.add('bg-tech-blue', 'text-black');
            }
            navigateTo('catalogo');
            renderCatalog();
        }

        function renderFeaturedProducts() {
            const container = document.getElementById('home-featured-grid');
            if (!container) return;
            container.innerHTML = PRODUCTS.slice(0, 4).map(p => createProductCardHTML(p)).join('');
        }

        function renderCatalog() {
            const container = document.getElementById('catalog-products-grid');
            if (!container) return;
            const searchQuery = document.getElementById('catalog-search')?.value.toLowerCase() || '';

            const filtered = PRODUCTS.filter(p => {
                const matchesCat = activeCategory === 'all' || p.category === activeCategory;
                const matchesSearch = p.name.toLowerCase().includes(searchQuery) || p.desc.toLowerCase().includes(searchQuery);
                return matchesCat && matchesSearch;
            });

            if (filtered.length === 0) {
                container.innerHTML = `<div class="col-span-full text-center py-12 text-slate-400"><i class="fa-solid fa-ghost text-4xl mb-3 text-slate-600"></i><p class="font-orbitron text-lg">No se encontraron componentes coincidentes.</p></div>`;
                return;
            }
            container.innerHTML = filtered.map(p => createProductCardHTML(p)).join('');
        }

        function createProductCardHTML(product) {
            return `
                <div class="bg-tech-card border border-tech-border rounded-xl overflow-hidden flex flex-col justify-between hover:border-tech-blue/60 transition-all hover:shadow-neon-sm group">
                    <div>
                        <div class="relative overflow-hidden h-48 bg-tech-darker">
                            <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <span class="absolute top-3 left-3 px-2 py-1 bg-tech-black/80 backdrop-blur-md text-tech-blue font-mono text-[10px] uppercase font-bold border border-tech-blue/30 rounded">${product.category.toUpperCase()}</span>
                        </div>
                        <div class="p-4 space-y-2">
                            <h3 class="font-bold text-white text-sm line-clamp-1 group-hover:text-tech-blue transition-colors">${product.name}</h3>
                            <p class="text-xs text-slate-400 line-clamp-2 font-light">${product.desc}</p>
                        </div>
                    </div>
                    <div class="p-4 pt-0 border-t border-tech-border/40 mt-3 flex items-center justify-between gap-2">
                        <span class="font-orbitron font-extrabold text-sm text-white">${formatARS(product.price)}</span>
                        <button onclick="addToCart('${product.id}')" class="p-2.5 rounded-lg bg-tech-blue/10 border border-tech-blue/40 text-tech-blue hover:bg-tech-blue hover:text-black transition-all">
                            <i class="fa-solid fa-cart-plus"></i>
                        </button>
                    </div>
                </div>
            `;
        }

        function renderPrebuiltPCs() {
            const container = document.getElementById('prebuilt-pcs-grid');
            if (!container) return;
            container.innerHTML = PREBUILT_PCS.map(pc => `
                <div class="bg-tech-card border border-tech-border rounded-xl overflow-hidden hover:border-tech-blue transition-all group flex flex-col justify-between">
                    <div>
                        <div class="relative h-56">
                            <img src="${pc.image}" alt="${pc.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <div class="absolute inset-0 bg-gradient-to-t from-tech-card via-transparent to-transparent"></div>
                            <span class="absolute top-4 right-4 bg-tech-blue text-black font-orbitron font-bold text-xs px-3 py-1 rounded-full shadow-neon-sm">Ensamblado TechFix</span>
                        </div>
                        <div class="p-6 space-y-4">
                            <h3 class="font-orbitron text-lg font-bold text-white">${pc.name}</h3>
                            <ul class="space-y-2 text-xs text-slate-300">
                                ${pc.specs.map(s => `<li class="flex items-center gap-2"><i class="fa-solid fa-check text-tech-blue"></i> ${s}</li>`).join('')}
                            </ul>
                        </div>
                    </div>
                    <div class="p-6 pt-0 border-t border-tech-border/40 flex items-center justify-between">
                        <div><span class="text-[10px] text-slate-400 block">Precio Total</span><span class="font-orbitron text-base font-black text-white">${formatARS(pc.price)}</span></div>
                        <button onclick="addPrebuiltToCart('${pc.id}')" class="px-4 py-2.5 rounded-xl bg-tech-blue text-black font-orbitron font-bold text-xs hover:bg-cyan-300 transition-colors shadow-neon-sm">COMPRAR</button>
                    </div>
                </div>
            `).join('');
        }

        function renderBuilderOptions() {
            renderBuilderCategory('cpu', PRODUCTS.filter(p => p.category === 'cpu'));
            renderBuilderCategory('motherboard', PRODUCTS.filter(p => p.category === 'motherboard'));
            renderBuilderCategory('gpu', PRODUCTS.filter(p => p.category === 'gpu'));
            renderBuilderCategory('ram', PRODUCTS.filter(p => p.category === 'ram'));
            renderBuilderCategory('storage', PRODUCTS.filter(p => p.category === 'storage'));
            renderBuilderCategory('psu', PRODUCTS.filter(p => p.category === 'psu'));
        }

        function renderBuilderCategory(category, items) {
            const container = document.getElementById(`builder-${category}-options`);
            if (!container) return;
            container.innerHTML = items.map(item => `
                <div onclick="selectBuilderComponent('${category}', '${item.id}')" id="builder-item-${item.id}" class="builder-option-card p-3 bg-tech-darker border border-tech-border rounded-lg cursor-pointer hover:border-tech-blue/50 transition-all flex items-center gap-3">
                    <img src="${item.image}" class="w-12 h-12 object-cover rounded-md">
                    <div class="flex-grow min-w-0">
                        <div class="text-xs font-bold text-white truncate">${item.name}</div>
                        <div class="text-xs text-tech-blue font-mono font-bold">${formatARS(item.price)}</div>
                    </div>
                </div>
            `).join('');
        }

        function selectBuilderComponent(category, productId) {
            const product = PRODUCTS.find(p => p.id === productId);
            builderSelection[category] = product;
            document.querySelectorAll(`#builder-${category}-options .builder-option-card`).forEach(el => el.classList.remove('border-tech-blue', 'bg-tech-blue/10'));
            const selectedEl = document.getElementById(`builder-item-${productId}`);
            if (selectedEl) selectedEl.classList.add('border-tech-blue', 'bg-tech-blue/10');
            document.getElementById(`builder-${category}-selected-name`).innerText = product.name;
            updateBuilderSummary();
        }

        function updateBuilderSummary() {
            let total = 0, totalWatts = 0;
            ['cpu', 'motherboard', 'gpu', 'ram', 'storage', 'psu'].forEach(cat => {
                const selected = builderSelection[cat];
                const sumEl = document.getElementById(`sum-${cat}`);
                if (selected) {
                    sumEl.innerText = formatARS(selected.price);
                    total += selected.price;
                    totalWatts += selected.watts || 0;
                } else {
                    sumEl.innerText = '$ 0 ARS';
                }
            });
            document.getElementById('builder-watts').innerText = `${totalWatts} Watts`;
            document.getElementById('builder-total-price').innerText = formatARS(total);
            const btn = document.getElementById('btn-add-builder');
            if (builderSelection.cpu && builderSelection.gpu && builderSelection.ram && builderSelection.storage) {
                btn.disabled = false;
                btn.classList.remove('bg-slate-700', 'cursor-not-allowed');
                btn.classList.add('bg-tech-blue', 'hover:bg-cyan-300', 'shadow-neon-blue');
            } else {
                btn.disabled = true;
                btn.classList.add('bg-slate-700', 'cursor-not-allowed');
                btn.classList.remove('bg-tech-blue', 'hover:bg-cyan-300', 'shadow-neon-blue');
            }
        }

        function resetBuilder() {
            builderSelection = { cpu: null, motherboard: null, gpu: null, ram: null, storage: null, psu: null };
            ['cpu', 'motherboard', 'gpu', 'ram', 'storage', 'psu'].forEach(cat => {
                document.getElementById(`builder-${cat}-selected-name`).innerText = 'Sin seleccionar';
            });
            document.querySelectorAll('.builder-option-card').forEach(el => el.classList.remove('border-tech-blue', 'bg-tech-blue/10'));
            updateBuilderSummary();
        }

        function addCustomRigToCart() {
            const totalPrice = Object.values(builderSelection).reduce((acc, curr) => acc + (curr ? curr.price : 0), 0);
            const customRigItem = {
                id: 'custom-rig-' + Date.now(),
                name: 'Setup Personalizado TechFix LAB',
                price: totalPrice,
                image: builderSelection.gpu ? builderSelection.gpu.image : 'https://images.unsplash.com/photo-1587202372775-e229f172b9d7?auto=format&fit=crop&w=600&q=80',
                qty: 1
            };
            cart.push(customRigItem);
            updateCartUI();
            showToast('PC Custom añadida al carrito');
            toggleCartDrawer();
        }

        function addToCart(productId) {
            const product = PRODUCTS.find(p => p.id === productId);
            if (!product) return;
            const existing = cart.find(item => item.id === productId);
            if (existing) existing.qty++;
            else cart.push({ ...product, qty: 1 });
            updateCartUI();
            showToast(`${product.name} agregado`);
        }

        function addPrebuiltToCart(prebuiltId) {
            const pc = PREBUILT_PCS.find(p => p.id === prebuiltId);
            if (!pc) return;
            const existing = cart.find(item => item.id === prebuiltId);
            if (existing) existing.qty++;
            else cart.push({ ...pc, qty: 1 });
            updateCartUI();
            showToast(`${pc.name} agregada al carrito`);
            toggleCartDrawer();
        }

        function updateCartQty(id, delta) {
            const item = cart.find(i => i.id === id);
            if (!item) return;
            item.qty += delta;
            if (item.qty <= 0) cart = cart.filter(i => i.id !== id);
            updateCartUI();
        }

        function applyCoupon() {
            const code = document.getElementById('coupon-code')?.value.trim().toUpperCase();
            if (code === 'TECHFIX10') {
                discountPercentage = 0.10;
                showToast('¡Cupón del 10% OFF aplicado!');
            } else {
                alert('Cupón no válido. Utiliza TECHFIX10');
                discountPercentage = 0;
            }
            updateCartUI();
        }

        function updateCartUI() {
            const badge = document.getElementById('cart-badge');
            const totalCount = cart.reduce((acc, curr) => acc + curr.qty, 0);
            if (totalCount > 0) { badge.innerText = totalCount; badge.classList.remove('hidden'); }
            else { badge.classList.add('hidden'); }

            const container = document.getElementById('cart-items-container');
            if (cart.length === 0) {
                container.innerHTML = `<div class="text-center py-16 text-slate-400 space-y-3"><i class="fa-solid fa-basket-shopping text-5xl text-slate-600"></i><p class="font-orbitron text-sm">Tu carrito está vacío</p></div>`;
            } else {
                container.innerHTML = cart.map(item => `
                    <div class="flex items-center gap-4 bg-tech-card p-3 rounded-xl border border-tech-border">
                        <img src="${item.image}" class="w-16 h-16 object-cover rounded-lg">
                        <div class="flex-grow min-w-0">
                            <h4 class="text-xs font-bold text-white truncate">${item.name}</h4>
                            <div class="text-tech-blue font-mono font-bold text-xs mt-1">${formatARS(item.price)}</div>
                            <div class="flex items-center gap-2 mt-2">
                                <button onclick="updateCartQty('${item.id}', -1)" class="w-6 h-6 rounded bg-tech-darker border border-tech-border flex items-center justify-center text-xs text-white">-</button>
                                <span class="text-xs font-mono font-bold text-white px-1">${item.qty}</span>
                                <button onclick="updateCartQty('${item.id}', 1)" class="w-6 h-6 rounded bg-tech-darker border border-tech-border flex items-center justify-center text-xs text-white">+</button>
                            </div>
                        </div>
                    </div>
                `).join('');
            }

            const subtotal = cart.reduce((acc, curr) => acc + (curr.price * curr.qty), 0);
            const shipping = cart.length > 0 ? 12500 : 0;
            const discount = subtotal * discountPercentage;
            const total = Math.max(0, subtotal - discount + shipping);

            document.getElementById('cart-subtotal').innerText = formatARS(subtotal);
            document.getElementById('cart-shipping').innerText = cart.length > 0 ? formatARS(shipping) : '$ 0 ARS';
            const discountRow = document.getElementById('discount-row');
            if (discountPercentage > 0 && cart.length > 0) {
                discountRow.classList.remove('hidden');
                document.getElementById('cart-discount').innerText = `-${formatARS(discount)}`;
            } else {
                discountRow.classList.add('hidden');
            }
            document.getElementById('cart-total').innerText = formatARS(total);
        }

        function toggleCartDrawer() {
            const backdrop = document.getElementById('cart-backdrop');
            const panel = document.getElementById('cart-panel');
            if (panel.classList.contains('translate-x-full')) {
                backdrop.classList.remove('opacity-0', 'pointer-events-none');
                panel.classList.remove('translate-x-full');
            } else {
                backdrop.classList.add('opacity-0', 'pointer-events-none');
                panel.classList.add('translate-x-full');
            }
        }

        async function checkout() {
            if (cart.length === 0) {
                alert('Agrega productos al carrito para realizar tu orden.');
                return;
            }

            const orderData = {
                items: cart,
                total: cart.reduce((acc, curr) => acc + (curr.price * curr.qty), 0)
            };

            try {
                const res = await fetch('/api/orders', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(orderData)
                });
                const result = await res.json();
                alert(`¡Orden #${result.order_id} registrada con éxito en la base de datos! Te enviaremos el link de pago.`);
                cart = [];
                discountPercentage = 0;
                updateCartUI();
                toggleCartDrawer();
            } catch (err) {
                console.error("Error al registrar orden:", err);
                alert('¡Orden registrada localmente!');
            }
        }

        async function handleContactSubmit(event) {
            event.preventDefault();
            const contactData = {
                name: document.getElementById('contact-name').value,
                email: document.getElementById('contact-email').value,
                message: document.getElementById('contact-message').value
            };

            try {
                await fetch('/api/contacts', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(contactData)
                });
                showToast('Consulta guardada en Base de Datos con éxito');
                event.target.reset();
            } catch (err) {
                showToast('Consulta enviada con éxito');
                event.target.reset();
            }
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').innerText = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>
